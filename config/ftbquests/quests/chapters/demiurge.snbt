			}]
			x: 0.5d
			y: -12.0d
		}
		{
			dependencies: ["7028FEBF5709ABCE"]
			description: ["&6This place is truly treacherous. The cathedral is completely chaotic. I was able to eventually find a key in the central room, but I got lost for a while. Then, going outside at the balcony, I can see that part of the upper wall is collapsed and I can potentially enter the upper chamber through there. However, the path forward is blocked off by this strange gray fog still. I think this key would match the fog for the other side garden. There are several corrupted beings behind, prepare for battle."]
			id: "4500ED4931EC035D"
			rewards: [{
				id: "0C4654E3239455BD"
				type: "xp_levels"
				xp_levels: 1
			}]
