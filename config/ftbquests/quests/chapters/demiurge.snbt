		{
			dependencies: [
				"0404DD4A0D87F8E3"
				"0F3237156DE95B07"
				"772D16E67AD29556"
			]
			description: [
				"&6Gem Armour is the pinnacle of the entire magical side of the world. It trades the utility found in the armours of archmages or cultists for one thing and one thing only: pure raw immortality. Almost nothing in the entire universe is able to hurt gem armour."
				""
				"&6The armour does still boast some minor abilities due to the artefacts used in its creation, which can be toggled, such as night vision, step assist, or pushing hostiles away."
			]
			hide_until_deps_complete: true
			hide_until_deps_visible: true
