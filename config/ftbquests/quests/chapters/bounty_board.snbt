	quests: [
		{
			description: [
				"&4At our local tavern, there is a bounty board on the wall. People post various quests, whether they be landowners, mine owners, random lumberjacks or fishermen. Everyone is threatened by the various monsters that may appear. This is where us hunters come in."
				""
				"&4The commissions are often good enough to live off only bounties, but sometimes a bit of adventuring is required. Isn't that just more gambling though? We may not find any loot at all. At least we don't turn to banditry."
			]
			hide_dependent_lines: true
