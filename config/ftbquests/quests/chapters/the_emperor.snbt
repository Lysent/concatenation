		}
		{
			dependencies: ["206159A3C7A78447"]
			description: [
				"&5When I first grasped the Emperor card, I thought myself a father. I believed that if I built my people a paradise, they would return my protection with loyalty. I was naive.&r"
				""
				"&5Do you know what broke me? It was not a rebellion, nor the deaths of my beloved citizens, nor the cruel and savage invaders in every direction. It was the rain.&r"
				""
				"&5I once watched an entire construction crew abandon a critical defense wall because of a light drizzle. I stood there, soaking wet, laying the bricks myself while they huddled in a hut complaining about damp boots.&r"
				"{@pagebreak}"
				"&5So do not look for love. It is a resource they do not possess. Let them complain about the housing, the guards, the rations. They will demand steak while you hold the wolves at bay. Give them the meat - not because they deserve it, but because a mouth full of food cannot complain about the weather.&r"
			]
			entity_vis_size: 1.0f
			id: "5827E9110E4B19F9"
			invisible: true
			rewards: [
				{
					count: 3
					id: "14677649E2CFBF71"
					item: "minecraft:diamond"
					type: "item"
