		}
		{
			dependencies: ["0D6E099A1A242153"]
			description: [
				"&5You cannot rule a pile of rocks without a Builder. They must construct their own Hut before raising any other structure. Furthermore, their skill is bound by their station; they cannot build anything of a higher level than their own Hut."
				""
				"&5The Builder bears the weight of your ambition. As your demands increase, you will likely require more of them to maintain your colony's expansion. Do not hesitate to recruit for your workforce."
			]
			entity_vis_size: 1.0f
			id: "583A7AA84FEC027F"
			rewards: [
				{
					id: "1BE3A8B887502B0C"
