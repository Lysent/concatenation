		{
			dependencies: ["1BB571557F74D3A1"]
			dependency_requirement: "one_started"
			description: [
				"&7&o\"I found a city of bricks and left it a city of marble.\"&r"
				""
				"&5A noble sentiment, but you are currently ruling over a kingdom of dirt. To rectify that, flatten a 20x20 area and establish your foothold.&r"
				"{@pagebreak}"
				"&a(The camp cannot be placed if objects block the area. Right-click the supply camp on the ground to see a 3D preview. Use the arrow controls to position the camp within your cleared space, then click the green checkmark to place it. If placement fails, the terrain is still in the way, remove obstacles until it fits. Red lines will mark spots that need further clearing.)&r"
			]
			entity_vis_size: 1.0f
			id: "1E1870FAD295DEDE"
