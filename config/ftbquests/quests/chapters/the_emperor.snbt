		}
		{
			dependencies: ["0D6E099A1A242153"]
			description: ["&5Starving subjects cannot labor. Until you establish a Restaurant for automated distribution, you must hand-feed your workforce. Place food in their inventories. A dead citizen produces nothing but disease."]
			entity_vis_size: 1.0f
			hide_dependency_lines: true
