		}
		{
			dependencies: ["0D6E099A1A242153"]
			description: ["&5A true sovereign does not whittle sticks for his subordinates. Teach your Builder to craft simple structures that fit a 2x2 grid, such as torches. Once taught, they will cease their incessant begging and produce what is required independently."]
			entity_vis_size: 1.0f
