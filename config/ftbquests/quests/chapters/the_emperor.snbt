		}
		{
			dependencies: ["583A7AA84FEC027F"]
			description: [
				"&5Ignorance is often used to excuse laziness. Construct a University to unlock advanced knowledge. Each level grants space for another researcher, up to five. More researchers allow you to pursue multiple paths of research at the same time, but they do not speed up individual tasks."
				""
				"&5Note: Research will only progress while you are nearby. However, once your scholars reach level 3, they are competent enough to continue their work while you are away."
			]
			entity_vis_size: 1.0f
			id: "15B51FB56A64C303"
			rewards: [
				{
					count: 8
