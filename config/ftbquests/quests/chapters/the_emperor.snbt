	quests: [
		{
			dependencies: ["5FB472DF1ACE7FF4"]
			description: [
				"&5You may find the ruins of lesser rulers scattered across the lands - rotting monuments to incompetence. Scavenging these abandoned colonies is... resourceful, but true sovereignty is forged from nothing. Prove you are better than those who failed before you.&r"
				"{@pagebreak}"
				"&5Do not underestimate the cost of a colony. Subjects are a resource more volatile than coal or iron. They require food, housing, and protection, or they will succumb to sickness or rebellion.&r"
				""
				"&5Treat them not as friends, but as cogs in the great machine of your civilization. Govern them well, and they will build you a wonder. Neglect them, and you will rule over a graveyard.&r"
				"{@pagebreak}"
				"&7&o(If ruling a Graveyard is, in fact, your intent, please close this chapter and refer to the later entry on graveyards.)&r"
				""
				"&a(You do not need to find all colonies to start the next quest, only one will suffice.)"
			]
			entity_vis_size: 1.0f
			hide_until_deps_complete: true
			id: "1BB571557F74D3A1"
			rewards: [{
				id: "5118D5653FA17BEF"
