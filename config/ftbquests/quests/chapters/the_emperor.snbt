			x: 0.5d
			y: -12.0d
		}
		{
			dependencies: ["583A7AA84FEC027F"]
			description: [
				"&5Do not degrade yourself by acting as a delivery boy. If you require materials at a remote site - perhaps to bribe a potential recruit at the tavern - construct a Postbox. Your Couriers will fetch the items from the Warehouse.&r"
				""
				"&5Conversely, if you are burdened with debris, dump it into a Stash. A Courier will collect it, assuming they do not get distracted by a butterfly on the return journey.&r"
			]
			entity_vis_size: 1.0f
			hide_dependency_lines: true
			id: "3B40A769EDB26EA2"
