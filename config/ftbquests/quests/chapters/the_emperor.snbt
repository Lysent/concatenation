		}
		{
			dependencies: ["0D6E099A1A242153"]
			description: [
				"&5Disgraceful. Your subjects gorge on rotting flesh because you fail to provide basic sustenance. A sick workforce is a useless one. Do you expect loyalty while they starve?"
				""
				"&5Construct a Restaurant. Support it with animal herders or a Fisher's Hut. If these structures exist, ensure they are supplied."
				""
				"&5Give them bread and circuses and they will never revolt."
			]
			entity_vis_size: 1.0f
			hide_dependency_lines: true
