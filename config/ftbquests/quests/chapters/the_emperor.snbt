		{
			dependencies: ["5A11A2FC20E5CE2A"]
			description: [
				"&5Hand a peasant a bow, and they are as likely to shoot their own foot as the enemy. The Archery allows Archers in Training to gain experience with a minimized risk of friendly fire.&r"
				""
				"&5Simply provide them with a bow. They will fire upon Target Blocks until they are competent enough to be trusted with actual defense.&r"
				"{@pagebreak}"
				"&d\"My Lord, I struck the center!\"&r"
				"&5\"That is a cow, recruit. The target is to your left.\"&r"
				"&d\"...it's moving target practice?\"&r"
				"&5\"It will be your dinner, if you do not miss the next shot.\"&r"
			]
			entity_vis_size: 1.0f
			id: "6D56AD1BEC644A10"
