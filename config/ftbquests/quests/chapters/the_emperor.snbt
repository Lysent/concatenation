			}]
			x: -2.5d
			y: -24.0d
		}
		{
			dependencies: ["15B51FB56A64C303"]
			description: [
				"&5Historically speaking, steel dictates the longevity of most regimes. The Blacksmith operates as a 3x3 crafter, forging vanilla tools, armor, swords, and shields.&r"
				""
				"&5Note that they are metalworkers, not fletchers or engineers; they cannot craft bows or redstone devices. Additionally, like every other colonist, they lack initiative. You must teach them specific recipes before they will get to work.&r"
			]
			entity_vis_size: 1.0f
			id: "19D03831EB5EED02"
			rewards: [{
				count: 16
				id: "054ADA61F5EBDF99"
