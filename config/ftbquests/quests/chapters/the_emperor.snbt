		{
			dependencies: ["583A7AA84FEC027F"]
			description: [
				"&5Your subjects will always want more. To rule is to be eternally pestered.&r"
				""
				"&5However, unmet needs breed resentment like stagnant water breeds mosquitoes. Use the Clipboard to view every request currently pending in your domain. You need not grant every wish, but you must at least &lknow&r&5 what they are screaming for.&r"
			]
			entity_vis_size: 1.0f
			hide_dependency_lines: true
			id: "71FCF06A98CC66D7"
			rewards: [{
				id: "2D0F9C1101384C0F"
