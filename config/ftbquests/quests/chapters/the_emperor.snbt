		{
			dependencies: ["583A7AA84FEC027F"]
			description: [
				"&5The Town Hall is your command center. Consult it often.&r"
				""
				"&5Configure the hiring and housing edicts at your leisure. If you leave these decisions to the citizens, they will breed until they starve or hire the village idiot to guard the treasury.&r"
				""
				"&5Finally, select your banner, which will appear on guard towers and shields. Mark your territory. Unmarked property is just free real estate for the next conqueror.&r"
			]
			entity_vis_size: 1.0f
			id: "7D3489901AA47547"
			rewards: [
